# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries names only (no values) and is required by
# tests/staging-workflow.test.ts on every checkout, so track it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling logs (install/download/dev-server transcripts)
*.log
!.yarn/**/*.log

# playwright artifacts
/test-results/
/playwright-report/
/blob-report/

# local agent/tool state (session tracking, never source)
/.freebuff/

# staging E2E identities (synthetic credentials, never commit)
/e2e/staging/.auth/

.vercel
.env*
