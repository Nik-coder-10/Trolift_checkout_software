# ─── Trolift Solutions — environment template ──────────────────────────────
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# This file contains NAMES only. Full per-environment matrix (what is
# required where, what is public vs secret): docs/operations/environment-variables.md

# Public (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Owner UPI / payment system (server-only; resolved/verified server-side)
OWNER_UPI_ID=
OWNER_UPI_PAYEE_NAME=

# Trolift home state for GST (2-digit GST state code, e.g. 27).
# Determines CGST+SGST (same state) vs IGST (inter-state). Unset means
# IGST for all GST orders until confirmed.
TROLIFT_STATE_CODE=
# Seller block printed on every tax invoice (server-only).
TROLIFT_BUSINESS_NAME=
TROLIFT_BUSINESS_ADDRESS=
TROLIFT_BUSINESS_PHONE=
TROLIFT_BUSINESS_EMAIL=
TROLIFT_BUSINESS_GSTIN=
# Invoice number prefix (2-10 uppercase letters, default INV).
# Numbers render as PREFIX/FY/SEQ, e.g. INV/FY26-27/000042 — the
# financial year is computed per invoice, never hard-coded.
TROLIFT_INVOICE_PREFIX=
# Hours an order stays payable (displayed on the payment page; no auto-cancel yet)
PAYMENT_WINDOW_HOURS=

# Public API rate limits (requests per minute; window below in ms)
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_ORDERS_PER_MIN=
RATE_LIMIT_CLAIM_PER_MIN=
RATE_LIMIT_SESSION_PER_MIN=
RATE_LIMIT_RECOVER_PER_MIN=
RATE_LIMIT_DELIVERY_PER_MIN=
RATE_LIMIT_IMPORT_PER_MIN=
RATE_LIMIT_EXPORT_PER_MIN=
RATE_LIMIT_INVOICE_PER_MIN=
RATE_LIMIT_ADMIN_PER_MIN=
RATE_LIMIT_AUTH_PER_MIN=
RATE_LIMIT_READY_PER_MIN=

# Distributed rate limiting (server-only; REQUIRED in production).
# RATE_LIMIT_BACKEND=auto|memory|upstash (default auto: upstash when the
# two UPSTASH_* vars below are set, else in-process memory).
# Explicit memory is a conscious single-instance choice (disposable
# staging): allowed but logged as unshared. AUTO fallback to memory in
# production FAILS CLOSED for financial mutations (orders/claims/token
# endpoints/imports) rather than running unlimited.
RATE_LIMIT_BACKEND=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstream timeout for shared-store calls in ms (default 1500).
RATE_LIMIT_UPSTREAM_TIMEOUT_MS=

# Proxy trust (server-only). Set TRUST_PROXY_HEADERS=true ONLY when the
# app runs behind a proxy/load-balancer that OVERWRITES x-real-ip and
# x-forwarded-for. Otherwise arbitrary X-Forwarded-For values are
# ignored (unspoofable) and unknown clients share one conservative
# bucket. On Vercel, x-vercel-forwarded-for is always trusted.
TRUST_PROXY_HEADERS=

# Admin / ops
# IANA timezone for business-day boundaries (command center "today", daily
# reports). Default Asia/Kolkata; an INVALID name is flagged by /api/ready
# (it would silently shift day boundaries to UTC — not acceptable un-signalled).
BUSINESS_TIMEZONE=
# (Removed: ADMIN_ALERT_EMAIL — it was documented but never read by any code.
# Alerting is log-based; see docs/operations/monitoring.md.)
